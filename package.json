{
  "name": "gpt-usage-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:app": "tauri build --no-bundle",
    "make:icon": "python scripts/make_icon.py",
    "start:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/launch-user.ps1",
    "rebuild:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/rebuild-restart.ps1",
    "spike": "python scripts/spike_usage.py",
    "test": "tsc src/format.ts src/display-preferences.ts --outDir .test-dist --module ESNext --target ES2020 && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
